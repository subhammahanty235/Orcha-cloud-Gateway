# Orcha Cloud gateway configuration. All values are optional; these are the defaults.
# The gateway reads the process environment and does not load this file itself.

# Address the gateway listens on. Keep it on loopback until public exposure is designed.
ORCHA_LISTEN_ADDR=127.0.0.1:8081

# Base URL of the inference backend (llama-server).
ORCHA_INFERENCE_URL=http://127.0.0.1:8080

# Limit for one upstream inference call, as a Go duration.
ORCHA_UPSTREAM_TIMEOUT=300s

# Largest accepted request body, in bytes.
ORCHA_MAX_REQUEST_BYTES=1048576
